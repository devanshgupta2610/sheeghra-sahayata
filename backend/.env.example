# Sheeghra Sahayata — Backend environment
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Use the service_role (secret) key on the backend — never expose it to the frontend
SUPABASE_KEY=your_supabase_service_role_key
# Optional: public anon key if you ever need it for demos
# SUPABASE_ANON_KEY=your_anon_key

# Optional — AI Safety Helper uses built-in KB; set this to enhance replies via OpenAI
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
